# Rassam env
VITE_RASSAM_WS_URL=http://localhost:3002
VITE_RASSAM_STORAGE_URL=http://localhost:8080
VITE_RASSAM_AUTH_TOKEN=

# Room server
ROOM_PORT=3002
CORS_ORIGIN=*

# Storage
STORAGE_PORT=8080
# filesystem:///data | memory:// | s3://bucket/prefix | postgres://…
STORAGE_URI=filesystem:///data
STORAGE_MAX_BYTES=8388608
CORS_ORIGIN=*
# Single token or comma-separated multi-token (per-user/team)
STORAGE_AUTH_TOKEN=
STORAGE_AUTH_TOKENS=
STORAGE_REQUIRE_AUTH_READ=false
STORAGE_WRITE_RATE_LIMIT=120

# S3-compatible driver (when STORAGE_URI=s3://…)
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Postgres driver (when STORAGE_URI=postgres://…) — requires npm i pg in storage/
DATABASE_URL=
