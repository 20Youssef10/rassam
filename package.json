{
  "name": "rassam",
  "version": "0.4.0",
  "private": true,
  "description": "رسَّام — Arabic-first hand-drawn whiteboard (from scratch)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "start:room": "npm --prefix collab install && npm --prefix collab start",
    "start:storage": "npm --prefix storage start",
    "start:stack": "node scripts/start-stack.js"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.1.1",
    "@fontsource/aref-ruqaa": "^5.1.1",
    "@fontsource/cairo": "^5.1.1",
    "@fontsource/changa": "^5.1.1",
    "@fontsource/lemonada": "^5.1.1",
    "@fontsource/noto-naskh-arabic": "^5.1.1",
    "@fontsource/reem-kufi": "^5.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
